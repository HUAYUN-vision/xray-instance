NODE_ENV=development
PORT=3000
# пустой префикс: эндпоинт /commands вызывается без /api (passimx-vpn-bot)
GLOBAL_PREFIX=
LOG_LEVEL=debug
CORS_ORIGIN=*
SWAGGER_ENABLED=true
# ключ для заголовка X-API-Key (POST /commands): openssl rand -hex 32
API_KEY=change-me-to-long-random-secret-0123456789

# docker-compose: внешние порты API и Xray
API_PORT=440
XRAY_PORT=443
